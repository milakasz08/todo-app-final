{#
    Wlasny szablon renderowania paginacji (Tailwind).
    Zamiast polegac na wewnetrznych polach obiektu paginacji (ktore roznia
    sie miedzy wersjami paczki), linki budujemy sami na podstawie biezacej
    trasy i biezacych parametrow zapytania (?type=..., ?tags[]=... itd.
    sa dzieki temu zachowywane przy zmianie strony).
#}
{% if pagination.pageCount > 1 %}
    {% set currentRoute = app.request.attributes.get('_route') %}
    {% set baseParams = app.request.query.all %}

    <nav class="flex items-center justify-center gap-1.5 flex-wrap">

        {% if pagination.current > 1 %}
            <a href="{{ path(currentRoute, baseParams|merge({'page': pagination.current - 1})) }}"
               class="w-9 h-9 flex items-center justify-center rounded-lg text-sm font-semibold text-gray-600 bg-white border border-gray-200 hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 transition">
                <i class="fa-solid fa-chevron-left text-xs"></i>
            </a>
        {% else %}
            <span class="w-9 h-9 flex items-center justify-center rounded-lg text-sm font-semibold text-gray-300 bg-white border border-gray-100">
                <i class="fa-solid fa-chevron-left text-xs"></i>
            </span>
        {% endif %}

        {% for page in 1..pagination.pageCount %}
            {% if page == pagination.current %}
                <span class="w-9 h-9 flex items-center justify-center rounded-lg text-sm font-bold text-white bg-indigo-600 shadow-sm">{{ page }}</span>
            {% else %}
                <a href="{{ path(currentRoute, baseParams|merge({'page': page})) }}"
                   class="w-9 h-9 flex items-center justify-center rounded-lg text-sm font-semibold text-gray-600 bg-white border border-gray-200 hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 transition">{{ page }}</a>
            {% endif %}
        {% endfor %}

        {% if pagination.current < pagination.pageCount %}
            <a href="{{ path(currentRoute, baseParams|merge({'page': pagination.current + 1})) }}"
               class="w-9 h-9 flex items-center justify-center rounded-lg text-sm font-semibold text-gray-600 bg-white border border-gray-200 hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 transition">
                <i class="fa-solid fa-chevron-right text-xs"></i>
            </a>
        {% else %}
            <span class="w-9 h-9 flex items-center justify-center rounded-lg text-sm font-semibold text-gray-300 bg-white border border-gray-100">
                <i class="fa-solid fa-chevron-right text-xs"></i>
            </span>
        {% endif %}

    </nav>
{% endif %}
