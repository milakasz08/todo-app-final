{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.title'|trans }} - MediaStream{% endblock %}

{% block body %}
    <div class="max-w-md mx-auto">
        <div class="text-center mb-8">
            <div class="mx-auto h-12 w-12 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center mb-4 shadow-sm">
                <i class="fa-solid fa-user-gear text-xl"></i>
            </div>
            <h1 class="text-2xl font-black text-gray-900 tracking-tight">{{ 'profile.title'|trans }}</h1>
            <p class="mt-1.5 text-sm text-gray-400">{{ 'profile.subtitle'|trans }}</p>
        </div>

        {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}
            {{ form_errors(form) }}

            <div>
                {{ form_label(form.email, null, {'label_attr': {'class': 'block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2'}}) }}
                {{ form_widget(form.email) }}
                {{ form_errors(form.email) }}
            </div>

            <div>
                {{ form_label(form.plainPassword, null, {'label_attr': {'class': 'block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2'}}) }}
                {{ form_widget(form.plainPassword) }}
                <p class="mt-1.5 text-xs text-gray-400">{{ form.plainPassword.vars.help|trans }}</p>
                {{ form_errors(form.plainPassword) }}
            </div>

            <div class="pt-2">
                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-3 px-4 rounded-xl text-sm font-bold shadow-md shadow-indigo-100 hover:shadow-lg transition flex items-center justify-center">
                    <i class="fa-solid fa-floppy-disk mr-2"></i> {{ 'common.save_changes'|trans }}
                </button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
