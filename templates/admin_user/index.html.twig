{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.users.title'|trans }} - Admin{% endblock %}

{% block body %}
    <div class="mb-8 bg-gradient-to-r from-red-950 to-slate-950 rounded-2xl p-6 md:p-8 text-white shadow-lg relative overflow-hidden">
        <div class="relative z-10">
            <h1 class="text-3xl font-extrabold tracking-tight">{{ 'admin.users.title'|trans }}</h1>
            <p class="mt-2 text-red-200 max-w-xl text-sm md:text-base">{{ 'admin.users.subtitle'|trans }}</p>
        </div>
        <div class="absolute right-0 bottom-0 top-0 opacity-10 flex items-center pr-12 hidden lg:flex">
            <i class="fa-solid fa-users-gear text-[120px]"></i>
        </div>
    </div>

    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm overflow-hidden">
        <div class="p-6 border-b border-gray-100">
            <h2 class="text-xl font-bold text-gray-900">{{ 'admin.users.registered'|trans }}</h2>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                <tr class="bg-slate-50 text-xs font-bold text-gray-400 uppercase tracking-wider border-b border-gray-100">
                    <th class="p-4">ID</th>
                    <th class="p-4">{{ knp_pagination_sortable(pagination, 'admin.users.email'|trans, 'u.email') }}</th>
                    <th class="p-4">{{ 'admin.users.role'|trans }}</th>
                    <th class="p-4 text-right">{{ 'admin.users.actions'|trans }}</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                {% for user in pagination %}
                    <tr class="hover:bg-slate-50/50 transition">
                        <td class="p-4 font-semibold text-gray-500">#{{ user.id }}</td>
                        <td class="p-4 font-bold text-gray-900">{{ user.email }}</td>
                        <td class="p-4">
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-50 text-red-700 border border-red-100">
                                        <i class="fa-solid fa-user-shield mr-1"></i> {{ 'admin.users.role.admin'|trans }}
                                    </span>
                            {% else %}
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700">
                                        <i class="fa-solid fa-user mr-1"></i> {{ 'admin.users.role.reader'|trans }}
                                    </span>
                            {% endif %}
                        </td>
                        <td class="p-4 text-right">
                            {% if user != app.user %}
                                <form action="{{ path('app_admin_user_toggle', {'id': user.id}) }}" method="POST" class="inline">
                                    <button type="submit" class="text-xs font-semibold px-3 py-1.5 rounded-xl border border-gray-200 shadow-sm transition {% if 'ROLE_ADMIN' in user.roles %}bg-white hover:bg-rose-50 text-rose-600 hover:border-rose-200{% else %}bg-indigo-600 hover:bg-indigo-700 text-white{% endif %}">
                                        {% if 'ROLE_ADMIN' in user.roles %}
                                            {{ 'admin.users.action.demote'|trans }}
                                        {% else %}
                                            {{ 'admin.users.action.promote'|trans }}
                                        {% endif %}
                                    </button>
                                </form>
                            {% else %}
                                <span class="text-xs text-gray-400 italic font-medium pr-3">{{ 'admin.users.own_account'|trans }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-6">
        {% include 'paginator/pagination.html.twig' with {'pagination': pagination} %}
    </div>
{% endblock %}
