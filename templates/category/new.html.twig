{% extends 'base.html.twig' %}

{% block title %}{{ 'category.new.title'|trans }} - MediaStream{% endblock %}

{% block body %}
    <h1 class="text-2xl font-black text-gray-900 mb-6">{{ 'category.new.title'|trans }}</h1>

    {{ include('category/_form.html.twig') }}

    <a href="{{ path('app_category_index') }}" class="inline-block mt-4 text-sm font-semibold text-indigo-600 hover:text-indigo-700 transition">
        <i class="fa-solid fa-arrow-left mr-1.5"></i> {{ 'category.action.back_to_list'|trans }}
    </a>
{% endblock %}
