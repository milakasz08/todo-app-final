{% extends 'base.html.twig' %}

{% block title %}{{ category.Name }} - MediaStream{% endblock %}

{% block body %}
    <h1 class="text-2xl font-black text-gray-900 mb-6">{{ category.Name }}</h1>

    <table class="w-full text-left border-collapse mb-6">
        <tbody class="divide-y divide-gray-100 text-sm">
            <tr>
                <th class="py-2 pr-4 font-semibold text-gray-500">Id</th>
                <td class="py-2">{{ category.id }}</td>
            </tr>
            <tr>
                <th class="py-2 pr-4 font-semibold text-gray-500">{{ 'category.table.name'|trans }}</th>
                <td class="py-2">{{ category.Name }}</td>
            </tr>
        </tbody>
    </table>

    <div class="flex items-center gap-4">
        <a href="{{ path('app_category_index') }}" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700 transition">
            <i class="fa-solid fa-arrow-left mr-1.5"></i> {{ 'category.action.back_to_list'|trans }}
        </a>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="text-sm font-semibold text-gray-600 hover:text-gray-900 transition">
                <i class="fa-solid fa-pen-to-square mr-1.5"></i> {{ 'category.action.edit'|trans }}
            </a>

            {{ include('category/_delete_form.html.twig') }}
        {% endif %}
    </div>
{% endblock %}
