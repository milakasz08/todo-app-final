<form method="post" action="{{ path('app_category_delete', {'id': category.id}) }}" onsubmit="return confirm('{{ 'category.confirm_delete'|trans }}');" class="inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
    <button class="text-sm font-semibold text-rose-600 hover:text-rose-700 transition">
        <i class="fa-solid fa-trash mr-1.5"></i> {{ 'category.action.delete'|trans }}
    </button>
</form>
