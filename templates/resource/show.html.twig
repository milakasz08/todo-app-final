{% extends 'base.html.twig' %}

{% block title %}{{ resource.Title }} - MediaStream{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto">
        <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 mb-3">
            {{ resource.type.label|trans }}
        </span>
        <h1 class="text-2xl font-black text-gray-900 mb-6">{{ resource.Title }}</h1>

        <table class="w-full text-left border-collapse mb-6">
            <tbody class="divide-y divide-gray-100 text-sm">
                <tr>
                    <th class="py-2 pr-4 font-semibold text-gray-500">{{ 'resource.card.author'|trans }}</th>
                    <td class="py-2">{{ resource.Author }}</td>
                </tr>
                <tr>
                    <th class="py-2 pr-4 font-semibold text-gray-500">{{ 'resource.card.category'|trans }}</th>
                    <td class="py-2">{{ resource.category.name|default('resource.card.category_none'|trans) }}</td>
                </tr>
                <tr>
                    <th class="py-2 pr-4 font-semibold text-gray-500">{{ 'resource.card.available_qty'|trans }}</th>
                    <td class="py-2">{{ resource.Quantity }}</td>
                </tr>
            </tbody>
        </table>

        <div class="flex items-center gap-4">
            <a href="{{ path('app_resource_index') }}" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700 transition">
                <i class="fa-solid fa-arrow-left mr-1.5"></i> {{ 'resource.action.back_to_list'|trans }}
            </a>

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_resource_edit', {'id': resource.id}) }}" class="text-sm font-semibold text-gray-600 hover:text-gray-900 transition">
                    <i class="fa-solid fa-pen-to-square mr-1.5"></i> {{ 'resource.action.edit'|trans }}
                </a>

                {{ include('resource/_delete_form.html.twig') }}
            {% endif %}
        </div>
    </div>
{% endblock %}
