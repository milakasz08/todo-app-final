<form method="post" action="{{ path('app_resource_delete', {'id': resource.id}) }}" onsubmit="return confirm('{{ 'resource.confirm_delete'|trans }}');" class="inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ resource.id) }}">
    <button class="text-sm font-semibold text-rose-600 hover:text-rose-700 transition">
        <i class="fa-solid fa-trash mr-1.5"></i> {{ 'resource.action.delete'|trans }}
    </button>
</form>
